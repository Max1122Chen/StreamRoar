.ui-system-window {
    padding: 12px;
    font-size: 13px;
}

.main-content {
    flex-grow: 1;
}

/* Typography & General */

/* Cards & Layout */
.ui-card {
    margin-bottom: 20px;
}


/* Toolbar & Header Action */
.ui-toolbar-row {
    flex-direction: row;
    padding: 0 0px;
    align-items: center;
    justify-content: space-between;
}





.ui-asset-label {
    font-size: 13px;
    /* -unity-font-style: bold; */
    color: #e0e0e0;
    margin-right: 12px;
    margin-top: 1px;
}

.ui-asset-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 16px;
    height: 24px;
    margin-bottom: 0;
}

.ui-asset-field .unity-object-field__selector:hover {
    background-color: #333333;
    border-radius: 2px;
}

.ui-asset-field .unity-object-field__input:focus {
    border-color: #0078d4;
}

/* Input Fields */
.unity-base-field__label {
    min-width: 140px;
    width: 140px;
    max-width: 140px;
    color: #b3b3b3;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
}

.ui-tiny-input .unity-base-field__input {
    min-height: 14px;
    height: 14px;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* Inline Fields (Vector/Resolution/Slider) */
.ui-resolution-axis-label,
.ui-flat-field > .ui-resolution-axis-label.unity-label {
    color: #888888;
    margin-right: 8px;
    margin-left: 8px;
    -unity-text-align: middle-center;
}

.ui-resolution-field {
    width: 100px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.ui-resolution-field .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.ui-inline-slider-wrap {
    flex-grow: 1;
    margin-left: 4px;
    margin-right: 12px;
    justify-content: center;
}

.ui-inline-slider {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.ui-inline-slider .unity-base-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
}

.ui-inline-slider .unity-base-slider__input {
    flex-grow: 1;
}

.ui-inline-value {
    width: 40px;
    -unity-text-align: middle-right;
    color: #cccccc;
    -unity-font-style: normal;
}

/* Layer Table Grid */
.ui-layer-header-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px 2px 0px;
    background-color: rgba(0, 0, 0, 0.25);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

.ui-layer-column-header {
    color: #888888;
    -unity-font-style: bold;
    font-size: 12px;
    margin: 0;
    padding: 0;
}

.ui-layer-line {
    flex-direction: row;
    align-items: center;
    padding: 0 0px;
    padding-right: 8px;
    flex-grow: 1;
}


.ui-layer-line .ui-flat-field {
    margin: 0;
    margin-right: 0px;
}
.ui-layer-line .unity-base-field__input {
    margin-top: 2px;
    margin-bottom: 2px;
}


/* Column Widths */
.ui-layer-name-cell {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
    justify-content: center;
}
.ui-layer-name-compact-cell {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 14px;
    padding-left: 8px;
    justify-content: center;
}
.ui-layer-mode-cell {
    width: 170px;
    flex-shrink: 0;
    margin-right: 14px;
    justify-content: center;
}
.ui-layer-input-field {
    width: 100%;
    margin: 0;
}

.ui-layer-order-cell {
    width: 80px;
    flex-shrink: 0;
    margin-right: 14px;
    justify-content: center;
}
.ui-layer-ray-cell {
    width: 80px;
    flex-shrink: 0;
    margin-right: 6px;
    justify-content: center;
    align-items: center;
}
.ui-layer-remove-cell {
    width: 32px;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.ui-layer-ray-toggle .unity-base-field__label {
    display: none;
    width: 0;
}
.ui-layer-ray-toggle .unity-base-field__input {
    margin: 0;
    margin-left: 0;
    align-self: center;
}

/* Buttons */
.ui-action-button {
    padding: 4px 12px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    -unity-font-style: bold;
    margin-left: 6px;
    margin-right: 0px;
}

.button-secondary {
    background-color: #333333;
    border-color: #444444;
    color: #cccccc;
}
.button-secondary:hover {
    background-color: #404040;
}

.button-primary {
    background-color: #0078d4;
    border-color: #005a9e;
    color: #ffffff;
}
.button-primary:hover {
    background-color: #106ebe;
}

.button-danger {
    background-color: #d13438;
    border-color: #a80000;
    color: #ffffff;
}
.button-danger:hover {
    background-color: #e32726;
}

.ui-icon-button {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background-color: transparent;
    border-width: 0;
    justify-content: center;
    align-items: center;
}
.ui-icon-button:hover {
    background-color: #3c3c3c;
}

.ui-icon-image {
    width: 16px;
    height: 16px;
}

.ui-icon-fallback {
    color: #d13438;
    font-size: 16px;
    -unity-font-style: bold;
}

/* Tabs */
.ui-tab-bar {
    flex-direction: row;
    margin: 16px 0px 8px 0px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.ui-tab-button {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    margin: 0 4px;
    padding: 6px 12px;
    font-size: 13px;
    color: #cccccc;
    -unity-font-style: normal;
}

.ui-tab-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.ui-tab-button-active {
    border-bottom-color: #0078d4;
    color: #ffffff;
    -unity-font-style: bold;
}

.ui-tab-content-area {
    flex-grow: 1;
    padding: 4px 0px; 
}



/* Table Row Stripes */
.ui-sub-card {
    padding: 0;
    margin: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    border-radius: 0;
    flex-grow: 1;
}



.row-even {
    background-color: rgba(0, 0, 0, 0.15);
}

.row-odd {
    background-color: transparent;
}
/* Fix SO Field Padding */
.ui-asset-field 
.ui-asset-field .unity-object-field-display > .unity-label {
    margin-left: 2px;
}

.ui-table-rows {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    margin-bottom: 0px;
    background-color: transparent;
    overflow: hidden;
}

/* List Add Button */
.button-list-add {
    margin-left: 0;
    margin-right: 0;
    /* margin-top: 6px; */
    background-color: transparent;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.4);
    border-radius: 4px;
    height: 24px;
    -unity-text-align: middle-center;
    -unity-font-style: normal;
}

.button-list-add:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.8);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Item Add Buttons (+ Add Panel, + Add Scope, etc.) */
.button-add-item {
    margin-left: 6px;
    margin-right: 0;
    margin-top: -3px;
    margin-bottom: -1px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 4px;
    background-color: transparent;
    border-width: 0px;
    color: rgba(255, 255, 255, 0.4);
    height: 24px;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
    align-self: flex-start;
}

.button-add-item:hover {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.8);
}


/* Global padding for all input fields inside the window so text isn't stuck to borders */
.unity-base-field__input {
    padding-left: 0;
    padding-right: 0;
}

/* Ensure text inside textfields doesn't clip when typed */
.unity-text-input {
    padding-left: 0;
    padding-right: 0;
}




/* Fix ListView row spacing by resetting item padding, and make the whole background the drag handle! */
.unity-list-view__item {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    min-height: auto;
}
.unity-list-view__reorderable-handle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-image: none;
    padding: 0;
    margin: 0;
    justify-content: center;
    align-items: center;
}
/* --- Fix Drag Icon Visibility --- */
.unity-list-view__reorderable-handle {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    width: 100%; height: 100%; 
    background-color: transparent;
    opacity: 0; /* Make everything in it invisible */
}
.unity-list-view__reorderable-handle-bar,
.unity-list-view__reorderable-handle-icon {
    display: none;
}

/* === COLS FIX === */
.ui-layer-name-cell {
    flex-grow: 1; flex-shrink: 1; margin-right: 14px; justify-content: center;
}
.ui-layer-scope-cell {
    width: 150px; flex-shrink: 0; margin-right: 14px; justify-content: center;
}
.ui-layer-order-cell {
    width: 80px; flex-shrink: 0; margin-right: 14px; justify-content: center;
}
.ui-layer-ray-cell {
    width: 80px; flex-shrink: 0; margin-right: 14px; justify-content: center; align-items: center;
}
.ui-layer-remove-cell {
    width: 24px; flex-shrink: 0; justify-content: center; align-items: center;
}

.ui-layer-name-cell > .unity-base-field,
.ui-layer-scope-cell > .unity-base-field,
.ui-layer-order-cell > .unity-base-field {
    width: 100%;
}


/* ====== AGGRESSIVE PADDING REMOVAL FOR LISTIVEW ====== */
.unity-list-view {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
    border-width: 0;
}
.unity-scroll-view {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
    background-color: transparent;
}
.unity-scroll-view__content-viewport {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
}
.unity-scroll-view__content-container {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
}
.unity-list-view__item {
    padding: 0; padding-left: 0; padding-right: 0; margin-left: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    min-height: auto;
}

.unity-list-view__item {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}

.unity-list-view__reorderable-item__container {
    padding: 0;
    margin: 0;
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
}

.unity-list-view__reorderable-item__container {
    flex-direction: column;
}


/* Prefab Registry Cells */
.ui-prefab-id-cell {
    flex-grow: 1; flex-shrink: 1; margin-right: 14px; justify-content: center;
}
.ui-prefab-type-cell {
    width: 90px; flex-shrink: 0; margin-right: 14px; justify-content: center;
}
.ui-prefab-layer-cell {
    width: 120px; flex-shrink: 0; margin-right: 14px; justify-content: center;
}
.ui-prefab-pool-cell {
    width: 40px; flex-shrink: 0; align-items: center; justify-content: center;
}

.ui-prefab-type-cell > .unity-base-field,
.ui-prefab-layer-cell > .unity-base-field {
    width: 100%;
}

/* UI Prefabs Registry Classes */
.ui-prefab-id-cell {
    width: 60%;
    margin-right: 5px;
}

.ui-prefab-layer-cell {
    width: 25%;
    margin-right: 5px;
}

.ui-prefab-pool-cell {
    width: 15%;
    margin-right: 5px;
}

.ui-table-rows {
    background-color: #282828;
    border-radius: 4px;
    padding-top: 2px; padding-bottom: 2px; padding-left: 0; padding-right: 0;
    margin-bottom: 0px;
}

/* Added directly from code logic */
.ui-prefab-card {
    flex-direction: row;
    background-color: rgb(46, 46, 46);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 0;
    padding-right: 0;
    margin-bottom: 6px;
    margin-left: 0;
    margin-right: 0;
}

.ui-type-badge-btn {
    background-color: rgb(51, 51, 51);
    color: rgb(178, 204, 255);
    border-width: 0;
    border-radius: 12px;
    height: 22px;
    font-size: 10px;
    align-self: center;
    padding: 0;
    margin: 0;
}

.ui-type-badge-btn:hover {
    background-color: rgb(64, 71, 89);
}

.ui-panel-section-title, .ui-widget-section-title {
    color: rgb(204, 204, 204);
    font-size: 13px;
    margin-bottom: 10px;
}
.ui-panel-section-title {
    margin-top: 12px;
}
.ui-widget-section-title {
    margin-top: 20px;
}

.ui-prefab-control-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    margin-right: 0px;
}
.ui-prefab-control-label {
    width: 75px;
    color: rgb(178, 178, 178);
}
.ui-prefab-control-field {
    flex-grow: 1;
    width: 100px;
}

.ui-prefab-info-col {
    width: 40%;
    justify-content: center;
    padding-right: 10px;
}
.ui-prefab-name {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 4px;
}
.ui-prefab-path {
    color: rgb(140, 140, 140);
    font-size: 11px;
    white-space: normal;
}
.ui-prefab-config-col {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}
.ui-prefab-action-col {
    width: 90px;
    justify-content: center;
}

/* Final cleanup definitions */
.ui-section-title-label {
    color: rgb(204, 204, 204);
    font-size: 13px;
    margin: 0;
    padding: 0;
}

.ui-flat-field {
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    align-items: center;
}

.ui-prefab-control-row {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
}

.ui-prefab-control-label {
    width: 75px;
    color: rgb(178, 178, 178);
}

.ui-prefab-control-field {
    flex-grow: 1;
    width: 100px;
}

.ui-type-badge-container {
    flex-direction: row;
    align-items: center;
}

.ui-type-badge-label {
    font-size: 10px;
    color: rgb(140, 140, 140);
    margin: 0 4px;
}




.ui-custom-object-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    flex-direction: row;
    min-height: 24px;
}

.ui-custom-object-field > .unity-base-field__label {
    color: rgb(204, 204, 204);
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    padding: 0;
    margin: 0;
    width: 100px;
    min-width: 100px;

}

.ui-toolbar-left {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.ui-toolbar-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.unity-base-field__input,
.unity-text-input,
.unity-base-popup-field__input {
    padding: 3px 6px;
    border-radius: 3px;
    flex-grow: 1;
}

.unity-base-slider__input {
    padding: 0;
}

.ui-custom-object-field {
    align-items: center;
}
.ui-custom-object-field > .unity-base-field__input {
    min-height: 24px;
    padding: 0;
    margin: 0;
    border-width: 1px;
    flex-grow: 1;
}
.ui-custom-object-field .unity-object-field-display {
    
    padding-right: 6px;
    margin: 0;
    align-items: center;
    justify-content: flex-start;
}
.ui-custom-object-field .unity-object-field-display > .unity-label {
    margin: 0;
    padding: 0;
}
.ui-custom-object-field .unity-object-field-display > .unity-image {
    margin-right: 6px;
    margin-left: 4px;
}
.ui-custom-object-field .unity-object-field__selector {
    background-color: transparent;
    border-width: 0;
}

.unity-label {
    margin: 0;
    padding: 0;
}

.ui-custom-object-field .unity-object-field__selector:hover {
    background-color: transparent;
}

.unity-base-field {
    margin-left: 0;
    margin-right: 0;
}

/* Fix inner text vertical alignment unconditionally inside input boxes */
.unity-base-field__input {
    justify-content: center;
}

/* Restoring proper vertical alignment inside the inputs */
.unity-base-field__input > .unity-text-element,
.unity-base-field__input > .unity-label,
.unity-object-field-display > .unity-label {
    -unity-text-align: middle-left;
}

.unity-text-input {
    -unity-text-align: middle-left;
}

/* Force standard height for all inputs and dropdowns globally */
.unity-base-field__input,
.unity-text-input,
.unity-base-popup-field__input {
    min-height: 24px;
    height: 24px;
}

.ui-layer-name-cell > .unity-label,
.ui-layer-name-cell > .unity-text-field > .unity-base-text-input {
    padding-right: 8px;
    padding-left: 0px;
    margin-left: 0px;
}

.ui-layer-name-cell {
    
    padding-right: 8px;
}

.ui-prefab-name {
    margin-bottom: 2px;
}

.ui-table-dropdown > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 4px;
    
    padding-right: 6px;
    margin: 0px;
    min-height: 22px;
}
.ui-table-dropdown > .unity-base-field__input:hover {
    background-color: rgba(0, 0, 0, 0.4);
}
.ui-drop-target {
    border-bottom-width: 2px;
    border-bottom-color: #3A79CB;
}
.ui-table-rows {
    padding-bottom: 2px;
}

.ui-table-rows {
    /* Ensuring drop targets remain valid during empty lists */
    min-height: 24px;
}

.unity-list-view__empty-label {
    
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.ui-layer-name-cell {
    padding-left: 10px;
}
.unity-list-view__empty-label {
    padding-left: 10px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0px;
    margin-bottom: 0px;
}

/* Customized Badge for Layer Dropdown */
.ui-layer-badge-dropdown {
    margin: 0;
    padding: 0;
    height: 20px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    overflow: hidden;
}

.ui-layer-badge-dropdown:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
}

/* Inner elements styling for UIElements PopupField structure */
.ui-layer-badge-dropdown > .unity-base-field__input {
    background-color: transparent;
    border-width: 0;
    padding-left: 10px;
    padding-right: 6px;
}

.ui-layer-badge-dropdown .unity-text-element {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: #a0a0a0;
    font-size: 11px;
}

.ui-layer-badge-dropdown .unity-popup-field__arrow {
    -unity-background-image-tint-color: #808080;
}
